# ─────────────────────────────────────────────────────────────────────────────
# mitim_base.mplstyle
# Base rcParams shared by all MITIM themes.
# Do NOT use this directly — use mitim_default or mitim_paper.
# ─────────────────────────────────────────────────────────────────────────────

# ── Fonts ─────────────────────────────────────────────────────────────────────
font.family        : sans-serif
font.size          : 11
axes.labelsize     : 11
axes.titlesize     : 11
axes.titlepad      : 8
axes.labelpad      : 5
xtick.labelsize    : 9.5
ytick.labelsize    : 9.5
legend.fontsize    : 9.5

# ── Tick geometry ─────────────────────────────────────────────────────────────
axes.linewidth      : 0.8
xtick.color         : black
ytick.color         : black
xtick.major.width   : 0.8
ytick.major.width   : 0.8
xtick.minor.width   : 0.4
ytick.minor.width   : 0.4
xtick.major.size    : 5
ytick.major.size    : 5
xtick.minor.size    : 3
ytick.minor.size    : 3
xtick.direction     : in
ytick.direction     : in
xtick.top           : True
ytick.right         : True

# ── Lines & markers ───────────────────────────────────────────────────────────
lines.linewidth     : 1.5
lines.markersize    : 5

# ── Legend ────────────────────────────────────────────────────────────────────
legend.framealpha   : 0.85
legend.edgecolor    : 0.75
legend.borderpad    : 0.5
legend.handlelength : 1.5
legend.labelspacing : 0.35

# ── Number / math formatting ──────────────────────────────────────────────────
axes.formatter.use_mathtext : True
axes.formatter.limits       : -3, 4

# ── Color cycle — Wong (2011), yellow last; overflow from legacy MITIM ────────
axes.prop_cycle : cycler('color', ['000000', 'E69F00', '56B4E9', '009E73', '0072B2', 'D55E00', 'CC79A7', '999999', '44AA99', 'F0E442', '0000FF', 'FF0000', 'FF00FF', 'FFA500', '00FFFF', '008000', 'D2691E', '808000', 'FF00FF', '708090'])

# ── Save quality ──────────────────────────────────────────────────────────────
savefig.dpi         : 300
savefig.bbox        : tight
savefig.pad_inches  : 0.05

# ── Grid (subtle, toggled on by addDenseAxis) ─────────────────────────────────
grid.color          : 0.0
grid.alpha          : 0.15
grid.linewidth      : 0.2
grid.linestyle      : -
